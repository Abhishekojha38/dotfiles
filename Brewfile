# Packages for a new machine. Install everything with `brew bundle`.
# Regenerate a superset of this file from the current machine with
# `brew bundle dump --force`, then trim it back to what you actually want.

# ---- Shell ----
brew "zsh"
brew "powerlevel10k"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# ---- Terminal and multiplexer ----
cask "wezterm"
cask "font-meslo-lg-nerd-font"
brew "tmux"

# ---- Editor ----
brew "neovim"

# ---- Modern CLI utilities ----
brew "eza"
brew "zoxide"
brew "fzf"
brew "herdr"

# ---- AI coding agents ----
# These read the configuration this repository checks out into ~/.claude and
# ~/.copilot, so a machine without them has config that nothing consumes.
# Note: claude-code can also be installed with its own native installer, which
# tracks a faster release channel than the cask. Pick one, not both.
cask "claude-code"
cask "copilot-cli"
